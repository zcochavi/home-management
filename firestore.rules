rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Webtop homework — written only by Cloud Functions, readable by any authenticated user
    match /webtopClasses/{classId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Maps a joined member's own Firebase Auth uid (family-code or kid-code account) to the
    // family they belong to. A user may only ever write their own mapping; read is open since
    // the mapping itself (uid -> uid) isn't sensitive on its own.
    function familyOfUid(uid) {
      return get(/databases/$(database)/documents/uidToFamily/$(uid)).data.familyUid;
    }
    match /uidToFamily/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // A family's private data: chores, grocery, homework, members (incl. kids' name/dob/gender/
    // school), join codes, fcm tokens, notifications. Accessible to the family owner (whose own
    // auth uid equals the family doc id) and to joined members via the uidToFamily mapping above.
    match /families/{familyUid} {
      allow read, write: if request.auth != null && (
        request.auth.uid == familyUid ||
        (exists(/databases/$(database)/documents/uidToFamily/$(request.auth.uid)) &&
         familyOfUid(request.auth.uid) == familyUid)
      );
      match /{document=**} {
        allow read, write: if request.auth != null && (
          request.auth.uid == familyUid ||
          (exists(/databases/$(database)/documents/uidToFamily/$(request.auth.uid)) &&
           familyOfUid(request.auth.uid) == familyUid)
        );
      }
    }

    // Public list shares (guest links). The document id is the secret token in the link.
    //  - get:    any signed-in user (guests are signed in anonymously) who knows the token.
    //            No `list`, so tokens can't be enumerated.
    //  - create/update/delete: family members only (the owner syncing/revoking its shares).
    //  - guest update: only on 'shared marking' (mode == 'edit') shares, and only the `items`
    //            array (+ updatedAt) — same length, mode/name/meta/steps/owner untouched.
    //            Rules can't iterate an array, so a guest could still alter an item's fields;
    //            moving checks to a separate map field would close that gap.
    function isFamilyMember(familyUid) {
      return request.auth != null && (
        request.auth.uid == familyUid ||
        (exists(/databases/$(database)/documents/uidToFamily/$(request.auth.uid)) &&
         familyOfUid(request.auth.uid) == familyUid)
      );
    }
    match /publicShares/{token} {
      allow get: if request.auth != null;
      allow create: if isFamilyMember(request.resource.data.familyUid);
      allow update: if
        (isFamilyMember(resource.data.familyUid) &&
         request.resource.data.familyUid == resource.data.familyUid)
        ||
        (request.auth != null &&
         resource.data.mode == 'edit' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['items', 'updatedAt']) &&
         request.resource.data.items is list &&
         request.resource.data.items.size() == resource.data.items.size());
      allow delete: if isFamilyMember(resource.data.familyUid);
    }

    // All other collections (school community directory, pending requests, join codes, etc.) — any authenticated user may read/write, same as before this file
    // existed. These are intentionally cross-family (community features) or need pre-mapping
    // access (e.g. reading a join code before the uidToFamily mapping above can exist yet).
    // Firestore evaluates every matching rule as OR'd together, so "families" and "uidToFamily"
    // must be explicitly excluded here — otherwise this catch-all would re-open them anyway.
    match /{collection}/{rest=**} {
      allow read, write: if request.auth != null
        && !(collection in ['families', 'uidToFamily', 'webtopClasses', 'publicShares']);
    }

    // Collection-group queries (e.g. collectionGroup('pendingEvents') in the admin Pending
    // Requests panel) are evaluated separately from the catch-all above — Firestore only honors
    // them against a rule shaped as {path=**}/<collectionId>/{doc}, so each collection group
    // used that way needs its own explicit match here even though the catch-all already covers
    // direct reads of the same documents.
    match /{path=**}/pendingEvents/{pendingId} {
      allow read, write: if request.auth != null;
    }
  }
}
