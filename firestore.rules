rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Families ─────────────────────────────────────────────────────────────
    match /families/{familyId} {
      allow read, write: if request.auth != null;

      match /notifications/{notifId} {
        allow read, write: if request.auth != null;
      }
    }

    // ── School / community collections ───────────────────────────────────────
    match /cities/{cityId} {
      allow read: if request.auth != null;
      allow write: if false; // managed by Cloud Functions only
    }

    match /cities/{cityId}/schools/{schoolId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /cities/{cityId}/schools/{schoolId}/classes/{classId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /cities/{cityId}/schools/{schoolId}/classes/{classId}/events/{eventId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /cities/{cityId}/schools/{schoolId}/classes/{classId}/members/{memberId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /cities/{cityId}/schools/{schoolId}/pendingSchools/{pendingId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Admin ─────────────────────────────────────────────────────────────────
    match /admin/{docId} {
      allow read, write: if false; // Cloud Functions only
    }

    match /adminMessages/{msgId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /feedbacks/{fbId} {
      allow read, write: if request.auth != null;
    }

    // ── Webtop homework sync ──────────────────────────────────────────────────
    // Allow a family to read their class's homework doc.
    // Written only by Cloud Functions (admin SDK bypasses these rules).
    match /webtopClasses/{classId} {
      // Homework data is not sensitive. Any authenticated FamilyHub user may read.
      // The client-side query already filters by familyId, so only relevant docs load.
      // Written exclusively by Cloud Functions (admin SDK bypasses these rules).
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Presence ──────────────────────────────────────────────────────────────
    match /presence/{uid} {
      allow read, write: if request.auth != null;
    }
  }
}
