rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Webtop homework — written only by Cloud Functions, readable by any authenticated user
    match /webtopClasses/{classId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // All other collections: allow any authenticated user to read and write.
    // This preserves the existing behaviour that was in place before this file was created.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
