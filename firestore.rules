rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Webtop homework — written only by Cloud Functions, readable by any authenticated user
    match /webtopClasses/{classId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Maps a joined member's own Firebase Auth uid (family-code or kid-code account, or a personal
    // Google/email account) to the family they belong to. This mapping is what grants access to
    // a family's data below, so a user can only write their own, and only towards a family they
    // hold a join code for:
    //  (a) re-writing the mapping they already have (the app does this on every login);
    //  (b) a join code's invite account (CODE@fh.familyhub) -> the family that issued that code;
    //  (c) a personal account -> the family of the join code it presents in `joinCode`, as the
    //      member that code was issued for (so a kid's code can't be turned into a parent).
    function familyOfUid(uid) {
      return get(/databases/$(database)/documents/uidToFamily/$(uid)).data.familyUid;
    }
    function joinCodeData(code) {
      return get(/databases/$(database)/documents/joinCodes/$(code)).data;
    }
    function isInviteAccount() {
      return request.auth.token.email is string && request.auth.token.email.matches('^[a-z0-9]+@fh[.]familyhub$');
    }
    function inviteCode() {
      return request.auth.token.email.split('@')[0].upper();
    }
    match /uidToFamily/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['familyUid', 'memberName', 'joinCode'])
        && request.resource.data.familyUid is string
        && (
          (resource != null
            && request.resource.data.familyUid == resource.data.familyUid
            && request.resource.data.get('memberName', null) == resource.data.get('memberName', null))
          ||
          (isInviteAccount()
            && joinCodeData(inviteCode()).ownerUid == request.resource.data.familyUid
            && (request.resource.data.get('memberName', null) == null
                || request.resource.data.memberName == joinCodeData(inviteCode()).get('memberName', null)))
          ||
          (!isInviteAccount()
            && request.resource.data.get('joinCode', null) is string
            && request.resource.data.joinCode.matches('^[A-Z0-9]{4,12}$')
            && joinCodeData(request.resource.data.joinCode).ownerUid == request.resource.data.familyUid
            && request.resource.data.get('memberName', null) == joinCodeData(request.resource.data.joinCode).get('memberName', null))
        );
      allow delete: if false;
    }

    // Join codes: the document id is the code, and says which family (and optionally which
    // member) it invites to. Knowing a code lets you read it; codes can't be listed. Only
    // members of a family can issue, change or remove that family's codes, and a code can never
    // be re-pointed at another family.
    match /joinCodes/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if isFamilyMember(request.resource.data.ownerUid);
      allow update: if isFamilyMember(resource.data.ownerUid)
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isFamilyMember(resource.data.ownerUid);
    }

    // A family's private data: chores, grocery, homework, members (incl. kids' name/dob/gender/
    // school), join codes, fcm tokens, notifications. Accessible to the family owner (whose own
    // auth uid equals the family doc id) and to joined members via the uidToFamily mapping above.
    match /families/{familyUid} {
      allow read, write: if request.auth != null && (
        request.auth.uid == familyUid ||
        (exists(/databases/$(database)/documents/uidToFamily/$(request.auth.uid)) &&
         familyOfUid(request.auth.uid) == familyUid)
      );
      match /{document=**} {
        allow read, write: if request.auth != null && (
          request.auth.uid == familyUid ||
          (exists(/databases/$(database)/documents/uidToFamily/$(request.auth.uid)) &&
           familyOfUid(request.auth.uid) == familyUid)
        );
      }
    }

    // Google Calendar refresh tokens — server-side only (Cloud Functions via the Admin SDK).
    // Clients must never read these, so no rule grants access (and the catch-all excludes it).
    match /gcalTokens/{doc} {
      allow read, write: if false;
    }

    // Claude connector sign-in state (OAuth clients, one-time codes, access/refresh tokens) —
    // server-side only (functions/mcp.js via the Admin SDK). A client that could write here could
    // mint itself a token for any family, so these are also excluded from the catch-all below.
    match /mcpClients/{doc}   { allow read, write: if false; }
    match /mcpAuthCodes/{doc} { allow read, write: if false; }
    match /mcpTokens/{doc}    { allow read, write: if false; }

    // Public list shares (guest links). The document id is the secret token in the link.
    //  - get:    any signed-in user (guests are signed in anonymously) who knows the token.
    //            No `list`, so tokens can't be enumerated.
    //  - create/update/delete: family members only (the owner syncing/revoking its shares).
    //  - guest update: only on joint shares (mode 'edit' = shared marking, 'claim' = who brings what), and only the `items`
    //            array (+ updatedAt) — same length, mode/name/meta/steps/owner untouched.
    //            Rules can't iterate an array, so a guest could still alter an item's fields;
    //            moving checks to a separate map field would close that gap.
    function isFamilyMember(familyUid) {
      return request.auth != null && (
        request.auth.uid == familyUid ||
        (exists(/databases/$(database)/documents/uidToFamily/$(request.auth.uid)) &&
         familyOfUid(request.auth.uid) == familyUid)
      );
    }
    match /publicShares/{token} {
      allow get: if request.auth != null;
      allow create: if isFamilyMember(request.resource.data.familyUid);
      allow update: if
        (isFamilyMember(resource.data.familyUid) &&
         request.resource.data.familyUid == resource.data.familyUid)
        ||
        (request.auth != null &&
         resource.data.mode in ['edit', 'claim'] &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['items', 'updatedAt']) &&
         request.resource.data.items is list &&
         request.resource.data.items.size() == resource.data.items.size());
      allow delete: if isFamilyMember(resource.data.familyUid);
    }

    // All other collections (school community directory, pending requests, etc.) — any authenticated user may read/write, same as before this file
    // existed. These are intentionally cross-family (community features).
    // Firestore evaluates every matching rule as OR'd together, so "families" and "uidToFamily"
    // must be explicitly excluded here — otherwise this catch-all would re-open them anyway.
    match /{collection}/{rest=**} {
      allow read, write: if request.auth != null
        && !(collection in ['families', 'uidToFamily', 'joinCodes', 'webtopClasses', 'publicShares', 'gcalTokens',
                            'mcpClients', 'mcpAuthCodes', 'mcpTokens']);
    }

    // Collection-group queries (e.g. collectionGroup('pendingEvents') in the admin Pending
    // Requests panel) are evaluated separately from the catch-all above — Firestore only honors
    // them against a rule shaped as {path=**}/<collectionId>/{doc}, so each collection group
    // used that way needs its own explicit match here even though the catch-all already covers
    // direct reads of the same documents.
    match /{path=**}/pendingEvents/{pendingId} {
      allow read, write: if request.auth != null;
    }
  }
}
