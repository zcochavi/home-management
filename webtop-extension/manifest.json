{
  "manifest_version": 3,
  "name": "FamilyHub – Webtop & Mashov Connector",
  "version": "1.4.0",
  "description": "מחבר שיעורי בית מ-Webtop וממשו״ב ל-FamilyHub אוטומטית",
  "permissions": [
    "storage",
    "cookies",
    "tabs",
    "webRequest",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://webtop.smartschool.co.il/*",
    "https://webtopserver.smartschool.co.il/*",
    "https://web.mashov.info/*",
    "https://us-central1-familyhub-7fdd5.cloudfunctions.net/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FamilyHub Webtop & Mashov Connector"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.mashov.info/*"
      ],
      "js": [
        "mashov-capture.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://web.mashov.info/*"
      ],
      "js": [
        "mashov-bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
